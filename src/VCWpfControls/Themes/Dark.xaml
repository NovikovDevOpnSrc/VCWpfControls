<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:grid="clr-namespace:VCWpfControls.Grid">
    <!-- Dark theme palette — Fluent 2 dark tokens (brand #479EF5, the tinted neutral
         ramp on #292929 surfaces). -->
    <SolidColorBrush x:Key="{x:Static grid:GridResources.SurfaceBackgroundKey}" Color="#FF292929" />
    <SolidColorBrush x:Key="{x:Static grid:GridResources.HeaderBackgroundKey}" Color="#FF1F1F1F" />
    <SolidColorBrush x:Key="{x:Static grid:GridResources.HeaderForegroundKey}" Color="#FFD6D6D6" />
    <SolidColorBrush x:Key="{x:Static grid:GridResources.HeaderBorderKey}" Color="#FF3D3D3D" />
    <SolidColorBrush x:Key="{x:Static grid:GridResources.SelectionBackgroundKey}" Color="#FF115EA3" />
    <SolidColorBrush x:Key="{x:Static grid:GridResources.SelectionTextKey}" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="{x:Static grid:GridResources.CurrentCellBorderBrushKey}" Color="#FF479EF5" />
    <SolidColorBrush x:Key="{x:Static grid:GridResources.GridLineKey}" Color="#FF333333" />
    <SolidColorBrush x:Key="{x:Static grid:GridResources.AccentKey}" Color="#FF479EF5" />
    <SolidColorBrush x:Key="{x:Static grid:GridResources.AccentTextKey}" Color="#FF77B7F7" />
    <SolidColorBrush x:Key="{x:Static grid:GridResources.HoverBackgroundKey}" Color="#FF333333" />
    <SolidColorBrush x:Key="{x:Static grid:GridResources.TextBrushKey}" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="{x:Static grid:GridResources.AlternatingRowBackgroundKey}" Color="#FF2F2F2F" />
    <SolidColorBrush x:Key="{x:Static grid:GridResources.MutedTextKey}" Color="#FFADADAD" />
    <SolidColorBrush x:Key="{x:Static grid:GridResources.BarFillKey}" Color="#FF3D3D3D" />
    <SolidColorBrush x:Key="{x:Static grid:GridResources.SeparatorLineKey}" Color="#FF3D3D3D" />
    <SolidColorBrush x:Key="{x:Static grid:GridResources.EventFillKey}" Color="#46479EF5" />
    <SolidColorBrush x:Key="{x:Static grid:GridResources.NowLineKey}" Color="#FFFF6A00" />
    <SolidColorBrush x:Key="{x:Static grid:GridResources.BaselineFillKey}" Color="#6E8C8C8C" />

    <!-- Implicit ComboBox (merged app-wide by ThemeManager): themed chrome + the 32px
         field minimum; the stock template would sit as a light box on the dark surface. -->
    <Style TargetType="ComboBox">
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Foreground" Value="{DynamicResource {x:Static grid:GridResources.TextBrushKey}}" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Padding" Value="8,0,24,0" />
        <Setter Property="MaxDropDownHeight" Value="220" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
        <!-- Full themed template: the STOCK template ignores Background/BorderBrush (the
             chrome is baked into the system theme), so a themed Foreground rendered as
             light text on light chrome — unreadable editors in the dark theme. -->
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton x:Name="Toggle" Focusable="False" ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="Bd" CornerRadius="4"
                                            Background="{DynamicResource {x:Static grid:GridResources.SurfaceBackgroundKey}}"
                                            BorderBrush="{DynamicResource {x:Static grid:GridResources.HeaderBorderKey}}"
                                            BorderThickness="1">
                                        <Path Data="M 0 0 L 4 4 L 8 0 Z" HorizontalAlignment="Right" VerticalAlignment="Center"
                                              Margin="0,0,8,0" Fill="{DynamicResource {x:Static grid:GridResources.MutedTextKey}}" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource {x:Static grid:GridResources.HoverBackgroundKey}}" />
                                        </Trigger>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource {x:Static grid:GridResources.AccentKey}}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <ContentPresenter IsHitTestVisible="False"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                          Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        <TextBox x:Name="PART_EditableTextBox" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"
                                 Background="Transparent" BorderThickness="0" Foreground="{TemplateBinding Foreground}"
                                 IsReadOnly="{TemplateBinding IsReadOnly}" Visibility="Collapsed" />
                        <Popup IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Placement="Bottom">
                            <Border Margin="0,2,0,0" CornerRadius="4" MinWidth="{TemplateBinding ActualWidth}"
                                    MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                    Background="{DynamicResource {x:Static grid:GridResources.SurfaceBackgroundKey}}"
                                    BorderBrush="{DynamicResource {x:Static grid:GridResources.HeaderBorderKey}}"
                                    BorderThickness="1">
                                <ScrollViewer>
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEditable" Value="True">
                            <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Toggle" Property="Opacity" Value="0.4" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Implicit ComboBoxItem + the dropdown surface: stock chrome renders light items on a
         light popup while the themed Foreground is light — white-on-white in dark (user
         report). The ListBox style is SCOPED to the ComboBox (the popup's list), not
         app-wide. -->
    <Style TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource {x:Static grid:GridResources.TextBrushKey}}" />
        <Setter Property="Background" Value="{DynamicResource {x:Static grid:GridResources.SurfaceBackgroundKey}}" />
    </Style>
    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource {x:Static grid:GridResources.TextBrushKey}}" />
    </Style>

    <!-- Implicit TextBox: stock chrome is a white box on dark surfaces (the grid's text
         editor, PropertyGrid value editors, filter row); the caret is black on dark too. -->
    <Style TargetType="TextBox">
        <Setter Property="Background" Value="{DynamicResource {x:Static grid:GridResources.SurfaceBackgroundKey}}" />
        <Setter Property="Foreground" Value="{DynamicResource {x:Static grid:GridResources.TextBrushKey}}" />
        <Setter Property="BorderBrush" Value="{DynamicResource {x:Static grid:GridResources.HeaderBorderKey}}" />
        <Setter Property="CaretBrush" Value="{DynamicResource {x:Static grid:GridResources.TextBrushKey}}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource {x:Static grid:GridResources.SelectionBackgroundKey}}" />
    </Style>
    <!-- Implicit DatePicker (GridDateColumn's editor): same stock-chrome class; its inner
         PART_TextBox follows the TextBox style above. The calendar DROPDOWN remains a
         stock system control (known limitation). -->
    <Style TargetType="DatePickerTextBox">
        <Setter Property="Foreground" Value="{DynamicResource {x:Static grid:GridResources.TextBrushKey}}" />
        <Setter Property="Background" Value="{DynamicResource {x:Static grid:GridResources.SurfaceBackgroundKey}}" />
        <Setter Property="CaretBrush" Value="{DynamicResource {x:Static grid:GridResources.TextBrushKey}}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource {x:Static grid:GridResources.SelectionBackgroundKey}}" />
    </Style>
    <Style TargetType="DatePicker">
        <Setter Property="Foreground" Value="{DynamicResource {x:Static grid:GridResources.TextBrushKey}}" />
    </Style>
</ResourceDictionary>
