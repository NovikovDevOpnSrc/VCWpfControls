<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:grid="clr-namespace:VCWpfControls.Grid">
    <!-- Dark theme palette — Fluent 2 dark tokens (brand #479EF5, the tinted neutral
         ramp on #292929 surfaces). -->
    <SolidColorBrush x:Key="{x:Static grid:GridResources.SurfaceBackgroundKey}" Color="#FF292929" />
    <SolidColorBrush x:Key="{x:Static grid:GridResources.HeaderBackgroundKey}" Color="#FF1F1F1F" />
    <SolidColorBrush x:Key="{x:Static grid:GridResources.HeaderForegroundKey}" Color="#FFD6D6D6" />
    <SolidColorBrush x:Key="{x:Static grid:GridResources.HeaderBorderKey}" Color="#FF3D3D3D" />
    <SolidColorBrush x:Key="{x:Static grid:GridResources.SelectionBackgroundKey}" Color="#FF115EA3" />
    <SolidColorBrush x:Key="{x:Static grid:GridResources.CurrentCellBorderBrushKey}" Color="#FF479EF5" />
    <SolidColorBrush x:Key="{x:Static grid:GridResources.GridLineKey}" Color="#FF333333" />
    <SolidColorBrush x:Key="{x:Static grid:GridResources.AccentKey}" Color="#FF479EF5" />
    <SolidColorBrush x:Key="{x:Static grid:GridResources.AccentTextKey}" Color="#FF77B7F7" />
    <SolidColorBrush x:Key="{x:Static grid:GridResources.HoverBackgroundKey}" Color="#FF333333" />
    <SolidColorBrush x:Key="{x:Static grid:GridResources.TextBrushKey}" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="{x:Static grid:GridResources.AlternatingRowBackgroundKey}" Color="#FF2F2F2F" />
    <SolidColorBrush x:Key="{x:Static grid:GridResources.MutedTextKey}" Color="#FFADADAD" />
    <SolidColorBrush x:Key="{x:Static grid:GridResources.BarFillKey}" Color="#FF3D3D3D" />

</ResourceDictionary>
