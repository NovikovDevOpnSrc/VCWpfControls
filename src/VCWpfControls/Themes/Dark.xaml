<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:grid="clr-namespace:VCWpfControls.Grid"
    xmlns:localization="clr-namespace:VCWpfControls.Localization">
    <!-- Dark theme palette — Fluent 2 dark tokens (brand #479EF5, the tinted neutral
         ramp on #292929 surfaces). -->
    <SolidColorBrush x:Key="{x:Static grid:GridResources.SurfaceBackgroundKey}" Color="#FF292929" />
    <SolidColorBrush x:Key="{x:Static grid:GridResources.HeaderBackgroundKey}" Color="#FF1F1F1F" />
    <SolidColorBrush x:Key="{x:Static grid:GridResources.HeaderForegroundKey}" Color="#FFD6D6D6" />
    <SolidColorBrush x:Key="{x:Static grid:GridResources.HeaderBorderKey}" Color="#FF3D3D3D" />
    <SolidColorBrush x:Key="{x:Static grid:GridResources.SelectionBackgroundKey}" Color="#FF115EA3" />
    <SolidColorBrush x:Key="{x:Static grid:GridResources.SelectionTextKey}" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="{x:Static grid:GridResources.CurrentCellBorderBrushKey}" Color="#FF479EF5" />
    <SolidColorBrush x:Key="{x:Static grid:GridResources.GridLineKey}" Color="#FF333333" />
    <SolidColorBrush x:Key="{x:Static grid:GridResources.AccentKey}" Color="#FF479EF5" />
    <SolidColorBrush x:Key="{x:Static grid:GridResources.AccentTextKey}" Color="#FF77B7F7" />
    <SolidColorBrush x:Key="{x:Static grid:GridResources.HoverBackgroundKey}" Color="#FF333333" />
    <SolidColorBrush x:Key="{x:Static grid:GridResources.TextBrushKey}" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="{x:Static grid:GridResources.AlternatingRowBackgroundKey}" Color="#FF2F2F2F" />
    <SolidColorBrush x:Key="{x:Static grid:GridResources.MutedTextKey}" Color="#FFADADAD" />
    <SolidColorBrush x:Key="{x:Static grid:GridResources.BarFillKey}" Color="#FF3D3D3D" />
    <SolidColorBrush x:Key="{x:Static grid:GridResources.SeparatorLineKey}" Color="#FF3D3D3D" />
    <SolidColorBrush x:Key="{x:Static grid:GridResources.EventFillKey}" Color="#46479EF5" />
    <SolidColorBrush x:Key="{x:Static grid:GridResources.NowLineKey}" Color="#FFFF6A00" />
    <SolidColorBrush x:Key="{x:Static grid:GridResources.BaselineFillKey}" Color="#6E8C8C8C" />
    <SolidColorBrush x:Key="{x:Static grid:GridResources.ErrorTextKey}" Color="#FFFF99A4" />
    <SolidColorBrush x:Key="{x:Static grid:GridResources.MenuHoverBackgroundKey}" Color="#FF333333" />

    <!-- Implicit ComboBox (merged app-wide by ThemeManager): themed chrome + the 32px
         field minimum; the stock template would sit as a light box on the dark surface. -->
    <Style TargetType="ComboBox">
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Foreground" Value="{DynamicResource {x:Static grid:GridResources.TextBrushKey}}" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Padding" Value="8,0,24,0" />
        <Setter Property="MaxDropDownHeight" Value="220" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
        <!-- Full themed template: the STOCK template ignores Background/BorderBrush (the
             chrome is baked into the system theme), so a themed Foreground rendered as
             light text on light chrome — unreadable editors in the dark theme. -->
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton x:Name="Toggle" Focusable="False" ClickMode="Press"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="Bd" CornerRadius="4"
                                            Background="{DynamicResource {x:Static grid:GridResources.SurfaceBackgroundKey}}"
                                            BorderBrush="{DynamicResource {x:Static grid:GridResources.HeaderBorderKey}}"
                                            BorderThickness="1">
                                        <Path Data="M 0 0 L 4 4 L 8 0 Z" HorizontalAlignment="Right" VerticalAlignment="Center"
                                              Margin="0,0,8,0" Fill="{DynamicResource {x:Static grid:GridResources.MutedTextKey}}" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource {x:Static grid:GridResources.HoverBackgroundKey}}" />
                                        </Trigger>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource {x:Static grid:GridResources.AccentKey}}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <ContentPresenter IsHitTestVisible="False"
                                          Content="{TemplateBinding SelectionBoxItem}"
                                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                          Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        <TextBox x:Name="PART_EditableTextBox" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"
                                 Background="Transparent" BorderThickness="0" Foreground="{TemplateBinding Foreground}"
                                 IsReadOnly="{TemplateBinding IsReadOnly}" Visibility="Collapsed" />
                        <Popup IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Placement="Bottom">
                            <Border Margin="0,2,0,0" CornerRadius="4" MinWidth="{TemplateBinding ActualWidth}"
                                    MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                    Background="{DynamicResource {x:Static grid:GridResources.SurfaceBackgroundKey}}"
                                    BorderBrush="{DynamicResource {x:Static grid:GridResources.HeaderBorderKey}}"
                                    BorderThickness="1">
                                <ScrollViewer>
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEditable" Value="True">
                            <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Toggle" Property="Opacity" Value="0.4" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Implicit ComboBoxItem + the dropdown surface: stock chrome renders light items on a
         light popup while the themed Foreground is light — white-on-white in dark (user
         report). The ListBox style is SCOPED to the ComboBox (the popup's list), not
         app-wide. -->
    <Style TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource {x:Static grid:GridResources.TextBrushKey}}" />
        <Setter Property="Background" Value="{DynamicResource {x:Static grid:GridResources.SurfaceBackgroundKey}}" />
    </Style>
    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource {x:Static grid:GridResources.TextBrushKey}}" />
    </Style>

    <Style TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource {x:Static grid:GridResources.TextBrushKey}}" />
    </Style>

    <!-- Implicit TextBox: stock chrome is a white box on dark surfaces (the grid's text
         editor, PropertyGrid value editors, filter row); the caret is black on dark too. -->
    <Style TargetType="TextBox">
        <Setter Property="Background" Value="{DynamicResource {x:Static grid:GridResources.SurfaceBackgroundKey}}" />
        <Setter Property="Foreground" Value="{DynamicResource {x:Static grid:GridResources.TextBrushKey}}" />
        <Setter Property="BorderBrush" Value="{DynamicResource {x:Static grid:GridResources.HeaderBorderKey}}" />
        <Setter Property="CaretBrush" Value="{DynamicResource {x:Static grid:GridResources.TextBrushKey}}" />
        <!-- 24px baseline: at/above the WCAG icon-only floor without inflating grid
             in-cell editing rows (form contexts set their own 32). -->
        <Setter Property="MinHeight" Value="24" />
        <Setter Property="SelectionBrush" Value="{DynamicResource {x:Static grid:GridResources.SelectionBackgroundKey}}" />
    </Style>
    <!-- Implicit DatePicker (GridDateColumn's editor): same stock-chrome class; its inner
         PART_TextBox follows the TextBox style above. The calendar DROPDOWN remains a
         stock system control (known limitation). -->
    <Style TargetType="DatePickerTextBox">
        <Setter Property="Foreground" Value="{DynamicResource {x:Static grid:GridResources.TextBrushKey}}" />
        <Setter Property="Background" Value="{DynamicResource {x:Static grid:GridResources.SurfaceBackgroundKey}}" />
        <Setter Property="CaretBrush" Value="{DynamicResource {x:Static grid:GridResources.TextBrushKey}}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource {x:Static grid:GridResources.SelectionBackgroundKey}}" />
    </Style>
    <Style TargetType="DatePicker">
        <Setter Property="Foreground" Value="{DynamicResource {x:Static grid:GridResources.TextBrushKey}}" />
    </Style>
    <SolidColorBrush x:Key="{x:Static grid:GridResources.OnAccentTextKey}" Color="#FFFFFFFF" />

    <!-- Implicit themed Button (merged app-wide by ThemeManager): the stock Aero2 chrome
         is a light box on dark surfaces and ignores Background setters — the same class
         the ComboBox template fixed. Full themed template: hover/pressed/disabled states
         through tokens, the shared focus ring, the 32px minimum. -->
    <Style TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource {x:Static grid:GridResources.TextBrushKey}}" />
        <Setter Property="Background" Value="{DynamicResource {x:Static grid:GridResources.SurfaceBackgroundKey}}" />
        <Setter Property="BorderBrush" Value="{DynamicResource {x:Static grid:GridResources.HeaderBorderKey}}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="12,4,12,4" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource {x:Static grid:GridResources.FocusVisualKey}}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border
                        x:Name="Bd"
                        Padding="{TemplateBinding Padding}"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="4"
                        SnapsToDevicePixels="True">
                        <ContentPresenter
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                            RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource {x:Static grid:GridResources.HoverBackgroundKey}}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource {x:Static grid:GridResources.SelectionBackgroundKey}}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ Chrome completion: ToolTip / GroupBox / Expander / Tabs / Slider / ProgressBar / ListBox / TreeView ============ -->

    <!-- ToolTip: surface card, 4px radius, 8,4 padding. -->
    <Style TargetType="ToolTip">
        <Setter Property="Foreground" Value="{DynamicResource {x:Static grid:GridResources.TextBrushKey}}" />
        <Setter Property="FontFamily" Value="{DynamicResource {x:Static grid:GridResources.FontFamilyKey}}" />
        <Setter Property="FontSize" Value="{DynamicResource {x:Static grid:GridResources.FontSizeCaptionKey}}" />
        <Setter Property="Background" Value="{DynamicResource {x:Static grid:GridResources.SurfaceBackgroundKey}}" />
        <Setter Property="BorderBrush" Value="{DynamicResource {x:Static grid:GridResources.HeaderBorderKey}}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="8,4,8,4" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border
                        Padding="{TemplateBinding Padding}"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="4"
                        SnapsToDevicePixels="True">
                        <ContentPresenter />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- GroupBox: 1px rounded frame, the header knocks out the top border (classic). -->
    <Style TargetType="GroupBox">
        <Setter Property="Foreground" Value="{DynamicResource {x:Static grid:GridResources.TextBrushKey}}" />
        <Setter Property="FontFamily" Value="{DynamicResource {x:Static grid:GridResources.FontFamilyKey}}" />
        <Setter Property="FontSize" Value="{DynamicResource {x:Static grid:GridResources.FontSizeBodyKey}}" />
        <Setter Property="BorderBrush" Value="{DynamicResource {x:Static grid:GridResources.SeparatorLineKey}}" />
        <Setter Property="Padding" Value="8,8,8,8" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GroupBox">
                    <Grid Margin="0,8,0,0">
                        <Border
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="4"
                            SnapsToDevicePixels="True" />
                        <Border
                            Background="{TemplateBinding Background}"
                            Margin="8,-8,0,0"
                            Padding="4,0,4,0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top">
                            <ContentPresenter
                                ContentSource="Header"
                                TextBlock.FontWeight="SemiBold"
                                RecognizesAccessKey="True" />
                        </Border>
                        <ContentPresenter Margin="{TemplateBinding Padding}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Expander: a header toggle (arrow rotates) + content below. -->
    <Style TargetType="Expander">
        <Setter Property="Foreground" Value="{DynamicResource {x:Static grid:GridResources.TextBrushKey}}" />
        <Setter Property="FontFamily" Value="{DynamicResource {x:Static grid:GridResources.FontFamilyKey}}" />
        <Setter Property="FontSize" Value="{DynamicResource {x:Static grid:GridResources.FontSizeBodyKey}}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="4" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Expander">
                    <StackPanel>
                        <ToggleButton
                            x:Name="HeaderToggle"
                            AutomationProperties.Name="{x:Static localization:GridStrings.ExpanderToggle}"
                            MinHeight="32"
                            Padding="4,0,4,0"
                            MinWidth="0"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Focusable="False"
                            IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <!-- Transparent inline chrome: the app-wide implicit
                                         ToggleButton style would box it and paint
                                         SelectionBackground while expanded. -->
                                    <Border
                                        x:Name="Bd"
                                        Background="Transparent"
                                        CornerRadius="4"
                                        Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource {x:Static grid:GridResources.HoverBackgroundKey}}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                            <StackPanel Orientation="Horizontal">
                                <Path
                                    x:Name="Arrow"
                                    Data="M 0 0 L 4 4 L 0 8 Z"
                                    Fill="{DynamicResource {x:Static grid:GridResources.MutedTextKey}}"
                                    Stretch="None"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    RenderTransformOrigin="0.5,0.5">
                                    <Path.RenderTransform>
                                        <RotateTransform Angle="-90" />
                                    </Path.RenderTransform>
                                </Path>
                                <ContentPresenter
                                    Margin="8,0,0,0"
                                    VerticalAlignment="Center"
                                    ContentSource="Header"
                                    RecognizesAccessKey="True" />
                            </StackPanel>
                        </ToggleButton>
                        <ContentPresenter
                            x:Name="ExpandSite"
                            Margin="{TemplateBinding Padding}"
                            Visibility="Collapsed" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsExpanded" Value="True">
                            <Setter TargetName="ExpandSite" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Arrow" Property="RenderTransform">
                                <Setter.Value>
                                    <RotateTransform Angle="0" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- TabControl: transparent host; TabPanel top (the items carry the chrome). -->
    <Style TargetType="TabControl">
        <Setter Property="Foreground" Value="{DynamicResource {x:Static grid:GridResources.TextBrushKey}}" />
        <Setter Property="FontFamily" Value="{DynamicResource {x:Static grid:GridResources.FontFamilyKey}}" />
        <Setter Property="FontSize" Value="{DynamicResource {x:Static grid:GridResources.FontSizeBodyKey}}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource {x:Static grid:GridResources.SeparatorLineKey}}" />
        <Setter Property="Padding" Value="8" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <!-- The 1px underline ties the strip to the page (Win11 tabs);
                             declared BEFORE the panel so the selected tab's accent underline
                             overpaints it (the reverse order struck a gray line through it). -->
                        <Border
                            Grid.Row="0"
                            VerticalAlignment="Bottom"
                            Height="1"
                            Background="{TemplateBinding BorderBrush}" />
                        <TabPanel
                            Grid.Row="0"
                            IsItemsHost="True" />
                        <Border
                            Grid.Row="1"
                            Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="SelectedContent" />
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- TabItem: 32px header; the selected tab carries the accent underline. -->
    <Style TargetType="TabItem">
        <Setter Property="Foreground" Value="{DynamicResource {x:Static grid:GridResources.TextBrushKey}}" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="MinWidth" Value="72" />
        <Setter Property="Padding" Value="12,0,12,0" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource {x:Static grid:GridResources.FocusVisualKey}}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Border
                        x:Name="Root"
                        Padding="{TemplateBinding Padding}"
                        Background="Transparent"
                        CornerRadius="4,4,0,0"
                        SnapsToDevicePixels="True">
                        <Grid>
                            <ContentPresenter
                                x:Name="HeaderHost"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                ContentSource="Header"
                                RecognizesAccessKey="True" />
                            <Rectangle
                                x:Name="Underline"
                                Height="2"
                                VerticalAlignment="Bottom"
                                Fill="{DynamicResource {x:Static grid:GridResources.AccentKey}}"
                                Visibility="Collapsed" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Underline" Property="Visibility" Value="Visible" />
                            <Setter Property="Foreground" Value="{DynamicResource {x:Static grid:GridResources.AccentTextKey}}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource {x:Static grid:GridResources.HoverBackgroundKey}}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Slider: the track on BarFill, a themed 20px round thumb; PART_Track is REQUIRED
         (the control drives it) — RepeatButtons transparent. -->
    <Style TargetType="Slider">
        <Setter Property="Foreground" Value="{DynamicResource {x:Static grid:GridResources.TextBrushKey}}" />
        <Setter Property="MinHeight" Value="24" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource {x:Static grid:GridResources.FocusVisualKey}}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid VerticalAlignment="Center">
                        <Border
                            Height="4"
                            VerticalAlignment="Center"
                            Background="{DynamicResource {x:Static grid:GridResources.BarFillKey}}"
                            CornerRadius="2" />
                        <Track x:Name="PART_Track">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="Slider.DecreaseLarge" Focusable="False"
                                              AutomationProperties.Name="{x:Static localization:GridStrings.SliderDecrease}">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Background="Transparent" />
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="Slider.IncreaseLarge" Focusable="False"
                                              AutomationProperties.Name="{x:Static localization:GridStrings.SliderIncrease}">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Background="Transparent" />
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Width="20" Height="20" Focusable="False">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Ellipse
                                                x:Name="ThumbDot"
                                                Fill="{DynamicResource {x:Static grid:GridResources.AccentKey}}"
                                                Stroke="{DynamicResource {x:Static grid:GridResources.SurfaceBackgroundKey}}"
                                                StrokeThickness="2" />
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ProgressBar: PART_Track + PART_Indicator (the control sizes the indicator). -->
    <Style TargetType="ProgressBar">
        <Setter Property="MinHeight" Value="12" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Border
                        Background="{DynamicResource {x:Static grid:GridResources.BarFillKey}}"
                        BorderBrush="{DynamicResource {x:Static grid:GridResources.HeaderBorderKey}}"
                        BorderThickness="1"
                        CornerRadius="6"
                        SnapsToDevicePixels="True">
                        <Grid Margin="1" ClipToBounds="True">
                            <Border
                                x:Name="PART_Track"
                                CornerRadius="5" />
                            <Border
                                x:Name="PART_Indicator"
                                HorizontalAlignment="Left"
                                Background="{DynamicResource {x:Static grid:GridResources.AccentKey}}"
                                CornerRadius="5" />
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ListBox: surface + border; items carry selection (grid's chosen-row pattern). -->
    <Style TargetType="ListBox">
        <Setter Property="Foreground" Value="{DynamicResource {x:Static grid:GridResources.TextBrushKey}}" />
        <Setter Property="FontFamily" Value="{DynamicResource {x:Static grid:GridResources.FontFamilyKey}}" />
        <Setter Property="FontSize" Value="{DynamicResource {x:Static grid:GridResources.FontSizeBodyKey}}" />
        <Setter Property="Background" Value="{DynamicResource {x:Static grid:GridResources.SurfaceBackgroundKey}}" />
        <Setter Property="BorderBrush" Value="{DynamicResource {x:Static grid:GridResources.HeaderBorderKey}}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="4" />
    </Style>

    <Style TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource {x:Static grid:GridResources.TextBrushKey}}" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Padding" Value="8,0,8,0" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource {x:Static grid:GridResources.FocusVisualKey}}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border
                        x:Name="Root"
                        Padding="{TemplateBinding Padding}"
                        Background="Transparent"
                        CornerRadius="4"
                        SnapsToDevicePixels="True">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource {x:Static grid:GridResources.HoverBackgroundKey}}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource {x:Static grid:GridResources.SelectionBackgroundKey}}" />
                            <Setter Property="Foreground" Value="{DynamicResource {x:Static grid:GridResources.SelectionTextKey}}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- TreeView: surface + border; items below. -->
    <Style TargetType="TreeView">
        <Setter Property="Foreground" Value="{DynamicResource {x:Static grid:GridResources.TextBrushKey}}" />
        <Setter Property="FontFamily" Value="{DynamicResource {x:Static grid:GridResources.FontFamilyKey}}" />
        <Setter Property="FontSize" Value="{DynamicResource {x:Static grid:GridResources.FontSizeBodyKey}}" />
        <Setter Property="Background" Value="{DynamicResource {x:Static grid:GridResources.SurfaceBackgroundKey}}" />
        <Setter Property="BorderBrush" Value="{DynamicResource {x:Static grid:GridResources.HeaderBorderKey}}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="4" />
    </Style>

    <Style TargetType="TreeViewItem">
        <Setter Property="Foreground" Value="{DynamicResource {x:Static grid:GridResources.TextBrushKey}}" />
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="Padding" Value="4,0,4,0" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource {x:Static grid:GridResources.FocusVisualKey}}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TreeViewItem">
                    <StackPanel>
                        <Border
                            x:Name="Root"
                            MinHeight="28"
                            Padding="{TemplateBinding Padding}"
                            Background="Transparent"
                            CornerRadius="4"
                            SnapsToDevicePixels="True">
                            <StackPanel Orientation="Horizontal">
                                <ToggleButton
                                    x:Name="Expander"
                                    AutomationProperties.Name="{x:Static localization:GridStrings.ExpanderToggle}"
                                    Width="24"
                                    Height="24"
                                    MinHeight="0"
                                    MinWidth="0"
                                    Padding="0"
                                    Focusable="False"
                                    IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border Background="Transparent">
                                                <Path
                                                    x:Name="Arrow"
                                                    Data="M 0 0 L 4 4 L 0 8 Z"
                                                    Fill="{DynamicResource {x:Static grid:GridResources.MutedTextKey}}"
                                                    Stretch="None"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    RenderTransformOrigin="0.5,0.5">
                                                    <Path.RenderTransform>
                                                        <RotateTransform Angle="-90" />
                                                    </Path.RenderTransform>
                                                </Path>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="Arrow" Property="RenderTransform">
                                                        <Setter.Value>
                                                            <RotateTransform Angle="0" />
                                                        </Setter.Value>
                                                    </Setter>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                                <ContentPresenter
                                    x:Name="PART_Header"
                                    Margin="4,0,0,0"
                                    VerticalAlignment="Center"
                                    ContentSource="Header" />
                            </StackPanel>
                        </Border>
                        <ItemsPresenter
                            x:Name="ItemsHost"
                            Margin="16,0,0,0"
                            Visibility="Collapsed" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsExpanded" Value="True">
                            <Setter TargetName="ItemsHost" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="HasItems" Value="False">
                            <Setter TargetName="Expander" Property="Visibility" Value="Hidden" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource {x:Static grid:GridResources.HoverBackgroundKey}}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource {x:Static grid:GridResources.SelectionBackgroundKey}}" />
                            <Setter Property="Foreground" Value="{DynamicResource {x:Static grid:GridResources.SelectionTextKey}}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ Status bar ============ -->
    <!-- Implicit StatusBar (merged app-wide by ThemeManager): a bottom information strip —
         caption-size text on the surface, a 1px top separator (Win11 status bars). -->
    <Style TargetType="StatusBar">
        <Setter Property="Foreground" Value="{DynamicResource {x:Static grid:GridResources.TextBrushKey}}" />
        <Setter Property="FontFamily" Value="{DynamicResource {x:Static grid:GridResources.FontFamilyKey}}" />
        <Setter Property="FontSize" Value="{DynamicResource {x:Static grid:GridResources.FontSizeCaptionKey}}" />
        <Setter Property="Background" Value="{DynamicResource {x:Static grid:GridResources.SurfaceBackgroundKey}}" />
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="Padding" Value="4,0,4,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="StatusBar">
                    <Border
                        Padding="{TemplateBinding Padding}"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{DynamicResource {x:Static grid:GridResources.SeparatorLineKey}}"
                        BorderThickness="0,1,0,0"
                        SnapsToDevicePixels="True">
                        <ItemsPresenter VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Implicit StatusBarItem: vertical centering, 8px horizontal rhythm. Item
         separators are themed 1px Rectangles (StatusBarItem has NO SeparatorStyleKey in
         WPF — unlike MenuItem; a plain <Separator/> renders a horizontal line). -->
    <Style TargetType="StatusBarItem">
        <Setter Property="Foreground" Value="{DynamicResource {x:Static grid:GridResources.TextBrushKey}}" />
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="Padding" Value="8,0,8,0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="StatusBarItem">
                    <Border Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <ContentPresenter VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <!-- ============ Menus (main bar + context) ============ -->
    <!-- Implicit Menu: a transparent bar host — items carry the chrome. -->
    <Style TargetType="Menu">
        <Setter Property="Foreground" Value="{DynamicResource {x:Static grid:GridResources.TextBrushKey}}" />
        <Setter Property="FontFamily" Value="{DynamicResource {x:Static grid:GridResources.FontFamilyKey}}" />
        <Setter Property="FontSize" Value="{DynamicResource {x:Static grid:GridResources.FontSizeBodyKey}}" />
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <!-- Implicit ContextMenu: surface card, 8px radius, 4px inner padding (Win11 menus).
         The grid's header menu and any consumer ContextMenu follow the theme. -->
    <Style TargetType="ContextMenu">
        <Setter Property="Foreground" Value="{DynamicResource {x:Static grid:GridResources.TextBrushKey}}" />
        <Setter Property="FontFamily" Value="{DynamicResource {x:Static grid:GridResources.FontFamilyKey}}" />
        <Setter Property="FontSize" Value="{DynamicResource {x:Static grid:GridResources.FontSizeBodyKey}}" />
        <Setter Property="Background" Value="{DynamicResource {x:Static grid:GridResources.SurfaceBackgroundKey}}" />
        <Setter Property="BorderBrush" Value="{DynamicResource {x:Static grid:GridResources.HeaderBorderKey}}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="4" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border
                        Margin="4"
                        Padding="{TemplateBinding Padding}"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="8"
                        SnapsToDevicePixels="True">
                        <ItemsPresenter />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Implicit MenuItem — ONE template for all roles (top-level/submenu items & headers;
         arrow/gesture columns collapse for top-level; the popup anchors to the role's
         placement). The Separator role swaps the whole template for a themed line. -->
    <Style TargetType="MenuItem">
        <Setter Property="Foreground" Value="{DynamicResource {x:Static grid:GridResources.TextBrushKey}}" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource {x:Static grid:GridResources.FocusVisualKey}}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border
                        x:Name="Root"
                        Padding="8,0,8,0"
                        Background="Transparent"
                        CornerRadius="4"
                        SnapsToDevicePixels="True">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition x:Name="IconCol" Width="24" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition x:Name="ArrowCol" Width="16" />
                            </Grid.ColumnDefinitions>

                            <Grid x:Name="IconHost" Width="24">
                                <ContentPresenter
                                    x:Name="IconPresenter"
                                    ContentSource="Icon"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center" />
                                <Path
                                    x:Name="Check"
                                    Data="M 0 4 L 3 7 L 8 0"
                                    Stroke="{TemplateBinding Foreground}"
                                    StrokeThickness="1.6"
                                    Stretch="None"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Visibility="Collapsed" />
                            </Grid>

                            <ContentPresenter
                                x:Name="HeaderHost"
                                Grid.Column="1"
                                Margin="0,0,24,0"
                                VerticalAlignment="Center"
                                ContentSource="Header"
                                RecognizesAccessKey="True" />

                            <TextBlock
                                x:Name="Gesture"
                                Grid.Column="2"
                                Margin="0,0,12,0"
                                VerticalAlignment="Center"
                                Foreground="{DynamicResource {x:Static grid:GridResources.MutedTextKey}}"
                                Text="{TemplateBinding InputGestureText}" />

                            <Path
                                x:Name="Arrow"
                                Grid.Column="3"
                                Data="M 0 0 L 4 4 L 0 8 Z"
                                Fill="{DynamicResource {x:Static grid:GridResources.MutedTextKey}}"
                                Stretch="None"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Visibility="Collapsed" />

                            <!-- The accent underline marks an OPEN top-level menu (Win11). -->
                            <Rectangle
                                x:Name="Underline"
                                Grid.ColumnSpan="4"
                                Height="2"
                                VerticalAlignment="Bottom"
                                Fill="{DynamicResource {x:Static grid:GridResources.AccentKey}}"
                                Visibility="Collapsed" />

                            <Popup
                                x:Name="PART_POPUP"
                                AllowsTransparency="True"
                                Focusable="False"
                                IsOpen="{TemplateBinding IsSubmenuOpen}"
                                Placement="Right"
                                PopupAnimation="None">
                                <Border
                                    Margin="0,4,0,4"
                                    Padding="4"
                                    Background="{DynamicResource {x:Static grid:GridResources.SurfaceBackgroundKey}}"
                                    BorderBrush="{DynamicResource {x:Static grid:GridResources.HeaderBorderKey}}"
                                    BorderThickness="1"
                                    CornerRadius="8">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Role" Value="TopLevelHeader">
                            <Setter TargetName="IconCol" Property="Width" Value="0" />
                            <Setter TargetName="IconHost" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="ArrowCol" Property="Width" Value="0" />
                            <Setter TargetName="Gesture" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="HeaderHost" Property="Margin" Value="0" />
                            <Setter TargetName="PART_POPUP" Property="Placement" Value="Bottom" />
                        </Trigger>
                        <Trigger Property="Role" Value="TopLevelItem">
                            <Setter TargetName="IconCol" Property="Width" Value="0" />
                            <Setter TargetName="IconHost" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="ArrowCol" Property="Width" Value="0" />
                            <Setter TargetName="Gesture" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="HeaderHost" Property="Margin" Value="0" />
                            <Setter TargetName="PART_POPUP" Property="Placement" Value="Bottom" />
                        </Trigger>
                        <Trigger Property="IsCheckable" Value="True">
                            <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                            <Setter TargetName="IconPresenter" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="False">
                            <Setter TargetName="Check" Property="Visibility" Value="Hidden" />
                        </Trigger>
                        <Trigger Property="HasItems" Value="True">
                            <Setter TargetName="Arrow" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsSubmenuOpen" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource {x:Static grid:GridResources.MenuHoverBackgroundKey}}" />
                            <Setter TargetName="Underline" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsHighlighted" Value="True" />
                                <Condition Property="IsEnabled" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource {x:Static grid:GridResources.MenuHoverBackgroundKey}}" />
                            <Setter Property="Foreground" Value="{DynamicResource {x:Static grid:GridResources.SelectionTextKey}}" />
                        </MultiTrigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Menu separators are themed through MenuItem.SeparatorStyleKey (the resource a
         <Separator/> inside a Menu/ContextMenu picks up automatically). -->
    <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="Separator">
        <Setter Property="Background" Value="{DynamicResource {x:Static grid:GridResources.SeparatorLineKey}}" />
        <Setter Property="Margin" Value="8,4,8,4" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Rectangle Height="1" Fill="{TemplateBinding Background}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Implicit Hyperlink: the stock link wears system blue — ~1-2:1 on the dark
         surface (issue #17). AccentText follows the palette (dark #77B7F7 = 6.86:1). -->
    <Style TargetType="Hyperlink">
        <Setter Property="Foreground" Value="{DynamicResource {x:Static grid:GridResources.AccentTextKey}}" />
    </Style>

    <!-- Implicit ToggleButton (issue #17): the stock chrome ignores Background setters
         (the proven ComboBox/Button class) — a full themed template with the checked
         state carried by the selection tokens. -->
    <Style TargetType="ToggleButton">
        <Setter Property="Foreground" Value="{DynamicResource {x:Static grid:GridResources.TextBrushKey}}" />
        <Setter Property="Background" Value="{DynamicResource {x:Static grid:GridResources.SurfaceBackgroundKey}}" />
        <Setter Property="BorderBrush" Value="{DynamicResource {x:Static grid:GridResources.HeaderBorderKey}}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="12,4,12,4" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource {x:Static grid:GridResources.FocusVisualKey}}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border
                        x:Name="Bd"
                        Padding="{TemplateBinding Padding}"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="4"
                        SnapsToDevicePixels="True">
                        <ContentPresenter
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                            RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource {x:Static grid:GridResources.HoverBackgroundKey}}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource {x:Static grid:GridResources.SelectionBackgroundKey}}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource {x:Static grid:GridResources.SelectionBackgroundKey}}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource {x:Static grid:GridResources.AccentKey}}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The primary CTA: accent fill for the ONE main action (Wizard Next/Finish). Hover
         steps to the accent-text shade (darker on light, lighter on dark). -->
    <Style x:Key="{x:Static grid:GridResources.PrimaryButtonStyleKey}" TargetType="Button"
           BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{DynamicResource {x:Static grid:GridResources.AccentKey}}" />
        <Setter Property="Foreground" Value="{DynamicResource {x:Static grid:GridResources.OnAccentTextKey}}" />
        <Setter Property="BorderBrush" Value="{DynamicResource {x:Static grid:GridResources.AccentKey}}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border
                        x:Name="Bd"
                        Padding="{TemplateBinding Padding}"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="4"
                        SnapsToDevicePixels="True">
                        <ContentPresenter
                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                            RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource {x:Static grid:GridResources.AccentTextKey}}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource {x:Static grid:GridResources.AccentTextKey}}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource {x:Static grid:GridResources.AccentKey}}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
