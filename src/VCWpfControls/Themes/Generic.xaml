<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:grid="clr-namespace:VCWpfControls.Grid"
    xmlns:primitives="clr-namespace:VCWpfControls.Grid.Primitives"
    xmlns:localization="clr-namespace:VCWpfControls.Localization"
    xmlns:propertyGrid="clr-namespace:VCWpfControls.PropertyGrid"
    xmlns:editors="clr-namespace:VCWpfControls.Editors"
    xmlns:docking="clr-namespace:VCWpfControls.Docking"
    xmlns:propertyGridPrimitives="clr-namespace:VCWpfControls.PropertyGrid.Primitives"
    xmlns:wizard="clr-namespace:VCWpfControls.Wizard"
    xmlns:gantt="clr-namespace:VCWpfControls.Gantt"
    xmlns:scheduler="clr-namespace:VCWpfControls.Scheduler"
    xmlns:treeList="clr-namespace:VCWpfControls.TreeList"
    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- ============ Theme palette (override these keys to re-theme the grid) ============ -->
    <SolidColorBrush x:Key="{x:Static grid:GridResources.SurfaceBackgroundKey}" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="{x:Static grid:GridResources.HeaderBackgroundKey}" Color="#FFF3F4F6" />
    <SolidColorBrush x:Key="{x:Static grid:GridResources.HeaderForegroundKey}" Color="#FF374151" />
    <SolidColorBrush x:Key="{x:Static grid:GridResources.HeaderBorderKey}" Color="#FFD1D5DB" />
    <SolidColorBrush x:Key="{x:Static grid:GridResources.SelectionBackgroundKey}" Color="#FFCFE3F5" />
    <SolidColorBrush x:Key="{x:Static grid:GridResources.CurrentCellBorderBrushKey}" Color="#FF2563EB" />
    <SolidColorBrush x:Key="{x:Static grid:GridResources.GridLineKey}" Color="#FFE5E7EB" />
    <SolidColorBrush x:Key="{x:Static grid:GridResources.AccentKey}" Color="#FF0F6CBD" />
    <SolidColorBrush x:Key="{x:Static grid:GridResources.AccentTextKey}" Color="#FF1D4ED8" />

    <!-- Fluent 2 foundations: the type ramp (Segoe UI Variable with fallbacks), the 4/8
         radius convention (controls 4, cards 8) and the 2px accent focus ring. -->
        <SolidColorBrush x:Key="{x:Static grid:GridResources.AlternatingRowBackgroundKey}" Color="#FFFAFAFA" />
    <SolidColorBrush x:Key="{x:Static grid:GridResources.MutedTextKey}" Color="#FF616161" />
    <SolidColorBrush x:Key="{x:Static grid:GridResources.BarFillKey}" Color="#FFE5E7EB" />

<FontFamily x:Key="{x:Static grid:GridResources.FontFamilyKey}">Segoe UI Variable Text, Segoe UI</FontFamily>
    <sys:Double x:Key="{x:Static grid:GridResources.FontSizeCaptionKey}">12</sys:Double>
    <sys:Double x:Key="{x:Static grid:GridResources.FontSizeBodyKey}">14</sys:Double>
    <sys:Double x:Key="{x:Static grid:GridResources.FontSizeSubtitleKey}">16</sys:Double>
    <sys:Double x:Key="{x:Static grid:GridResources.FontSizeTitleKey}">20</sys:Double>
    <Style x:Key="{x:Static grid:GridResources.FocusVisualKey}" TargetType="Control">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Control">
                    <Rectangle
                        Margin="2"
                        RadiusX="4"
                        RadiusY="4"
                        Stroke="{DynamicResource {x:Static grid:GridResources.AccentKey}}"
                        StrokeThickness="2" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <SolidColorBrush x:Key="{x:Static grid:GridResources.HoverBackgroundKey}" Color="#FFEDF2F9" />

    <SolidColorBrush x:Key="{x:Static grid:GridResources.TextBrushKey}" Color="#FF1F2937" />

    <!-- ============ GridControl ============ -->
    <Style TargetType="{x:Type grid:GridControl}">
        <Setter Property="Foreground" Value="{DynamicResource {x:Static grid:GridResources.TextBrushKey}}" />
        <Setter Property="FontFamily" Value="{DynamicResource {x:Static grid:GridResources.FontFamilyKey}}" />
        <Setter Property="FontSize" Value="{DynamicResource {x:Static grid:GridResources.FontSizeBodyKey}}" />
        <Setter Property="FocusVisualStyle" Value="{DynamicResource {x:Static grid:GridResources.FocusVisualKey}}" />
        <Setter Property="Background" Value="{DynamicResource {x:Static grid:GridResources.SurfaceBackgroundKey}}" />
        <Setter Property="BorderBrush" Value="{DynamicResource {x:Static grid:GridResources.HeaderBorderKey}}" />
        <Setter Property="GridLinesBrush" Value="{DynamicResource {x:Static grid:GridResources.GridLineKey}}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
        <Setter Property="VirtualizingStackPanel.VirtualizationMode" Value="Recycling" />
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <VirtualizingStackPanel
                        VirtualizationMode="Recycling"
                        ScrollUnit="Pixel" />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type grid:GridControl}">
                    <Border
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        Padding="{TemplateBinding Padding}"
                        SnapsToDevicePixels="True">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <primitives:GridGroupPanel x:Name="PART_GroupPanel" Grid.Row="0" />

                            <primitives:GridColumnHeadersPresenter x:Name="PART_ColumnHeadersPresenter" Grid.Row="1" />

                            <Border Grid.Row="2" Background="{DynamicResource {x:Static grid:GridResources.SurfaceBackgroundKey}}">
                                <!-- No horizontal margin: the presenter arranges editors by column slots — a margin
                                     shifts them off their headers (user-reported misalignment). -->
                                <primitives:GridFilterRowPresenter x:Name="PART_FilterRowPresenter" Margin="0,3,0,3" Visibility="Collapsed" />
                            </Border>

                            <ScrollViewer
                                x:Name="PART_ScrollViewer"
                                Grid.Row="3"
                                Focusable="False">
                                <ItemsPresenter />
                            </ScrollViewer>

                            <TextBlock
                                x:Name="PART_EmptyState"
                                Grid.Row="3"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontSize="14"
                                Opacity="0.55"
                                Text="{x:Static localization:GridStrings.NoData}"
                                Visibility="Collapsed" />

                            <Border Grid.Row="4" Background="{DynamicResource {x:Static grid:GridResources.HeaderBackgroundKey}}" BorderBrush="{DynamicResource {x:Static grid:GridResources.HeaderBorderKey}}" BorderThickness="0,1,0,0">
                                <primitives:GridSummaryRowPresenter x:Name="PART_SummaryRowPresenter" Margin="0,3,0,3" Visibility="Collapsed" />
                            </Border>

                            <ScrollBar
                                x:Name="PART_HorizontalScrollBar"
                                Grid.Row="5"
                                Orientation="Horizontal"
                                Visibility="Collapsed" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="ShowGroupPanel" Value="False">
                            <Setter TargetName="PART_GroupPanel" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="ShowColumnHeaders" Value="False">
                            <Setter TargetName="PART_ColumnHeadersPresenter" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="ShowFilterRow" Value="True">
                            <Setter TargetName="PART_FilterRowPresenter" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger SourceName="PART_SummaryRowPresenter" Property="HasContent" Value="True">
                            <Setter TargetName="PART_SummaryRowPresenter" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ GridGroupPanel ============ -->
    <Style TargetType="{x:Type primitives:GridGroupPanel}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type primitives:GridGroupPanel}">
                    <Border
                        MinHeight="26"
                        Margin="4,3,4,3"
                        Padding="6,2,6,2"
                        Background="{DynamicResource {x:Static grid:GridResources.SurfaceBackgroundKey}}"
                        BorderBrush="{DynamicResource {x:Static grid:GridResources.HeaderBorderKey}}"
                        BorderThickness="1"
                        CornerRadius="4">
                        <Grid>
                            <TextBlock
                                x:Name="PART_Hint"
                                VerticalAlignment="Center"
                                Opacity="0.55"
                                FontStyle="Italic"
                                Text="{x:Static localization:GridStrings.GroupPanelHint}"
                                TextTrimming="CharacterEllipsis" />
                            <ItemsControl x:Name="PART_ChipsHost">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsDropTarget" Value="True">
                            <Setter Property="Background" Value="{DynamicResource {x:Static grid:GridResources.SelectionBackgroundKey}}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource {x:Static grid:GridResources.AccentKey}}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ GridRow ============ -->
    <Style TargetType="{x:Type primitives:GridRow}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type primitives:GridRow}">
                    <Border
                        x:Name="RowBorder"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{Binding GridLinesBrush, RelativeSource={RelativeSource AncestorType={x:Type grid:GridControl}}}"
                        BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0">
                                <!-- No margin: cell slots must share the header presenter's origin. Cell padding
                                     comes from the generated elements (Margin 8,0,6,0), matching the header template. -->
                                <primitives:GridCellsPanel x:Name="PART_Cells" />
                                <CheckBox
                                    x:Name="PART_NodeCheckBox"
                                    Width="16"
                                    Height="16"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Left"
                                    Focusable="False"
                                    IsThreeState="True"
                                    Visibility="Collapsed" />
                                <ToggleButton
                                    x:Name="PART_TreeToggle"
                                    Width="16"
                                    Height="16"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Left"
                                    Focusable="False"
                                    Visibility="Collapsed">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border Background="Transparent">
                                                <Grid VerticalAlignment="Center" HorizontalAlignment="Center">
                                                    <Path x:Name="TreeArrowRight" Data="M 0 0 L 5 4 L 0 8 Z" Fill="{DynamicResource {x:Static grid:GridResources.AccentKey}}" />
                                                    <Path x:Name="TreeArrowDown" Data="M 0 0 L 8 0 L 4 5 Z" Fill="{DynamicResource {x:Static grid:GridResources.AccentKey}}" Visibility="Collapsed" />
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="TreeArrowRight" Property="Visibility" Value="Collapsed" />
                                                    <Setter TargetName="TreeArrowDown" Property="Visibility" Value="Visible" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>
                                <Border x:Name="PART_GroupHost" Visibility="Collapsed" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <ToggleButton x:Name="PART_GroupToggle" Width="16" Height="16" Focusable="False">
                                        <ToggleButton.Template>
                                            <ControlTemplate TargetType="ToggleButton">
                                                <Border Background="Transparent">
                                                    <Grid VerticalAlignment="Center" HorizontalAlignment="Center">
                                                        <Path x:Name="ArrowRight"
                                                              Data="M 0 0 L 5 4 L 0 8 Z"
                                                              Fill="{DynamicResource {x:Static grid:GridResources.AccentKey}}" />
                                                        <Path x:Name="ArrowDown"
                                                              Data="M 0 0 L 8 0 L 4 5 Z"
                                                              Fill="{DynamicResource {x:Static grid:GridResources.AccentKey}}"
                                                              Visibility="Collapsed" />
                                                    </Grid>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsChecked" Value="True">
                                                        <Setter TargetName="ArrowRight" Property="Visibility" Value="Collapsed" />
                                                        <Setter TargetName="ArrowDown" Property="Visibility" Value="Visible" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </ToggleButton.Template>
                                    </ToggleButton>
                                    <TextBlock x:Name="PART_GroupText" Margin="6,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold" />
                                    <ContentPresenter x:Name="PART_GroupHeaderContent" Margin="6,0,0,0" VerticalAlignment="Center" Visibility="Collapsed" />
                                </StackPanel>
                            </Border>
                            </Grid>
                            <ContentPresenter
                                x:Name="PART_RowDetails"
                                Grid.Row="1"
                                Margin="8,2,8,6"
                                Visibility="Collapsed"
                                ContentTemplate="{Binding RowDetailsTemplate, RelativeSource={RelativeSource AncestorType={x:Type grid:GridControl}}}" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsGroupRow" Value="True">
                            <Setter TargetName="PART_GroupHost" Property="Visibility" Value="Visible" />
                            <Setter TargetName="PART_Cells" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="RowBorder" Property="Background" Value="{DynamicResource {x:Static grid:GridResources.HoverBackgroundKey}}" />
                        </Trigger>
                        <Trigger Property="TreeHasChildren" Value="True">
                            <Setter TargetName="PART_TreeToggle" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="HasNodeCheckBox" Value="True">
                            <Setter TargetName="PART_NodeCheckBox" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="RowBorder" Property="Background" Value="{DynamicResource {x:Static grid:GridResources.HoverBackgroundKey}}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="RowBorder" Property="Background" Value="{DynamicResource {x:Static grid:GridResources.SelectionBackgroundKey}}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <ControlTemplate x:Key="HeaderResizeThumbTemplate" TargetType="Thumb">
        <Rectangle
            Fill="Transparent"
            Stroke="Transparent" />
    </ControlTemplate>

    <!-- ============ GridColumnHeader ============ -->
    <Style TargetType="{x:Type primitives:GridColumnHeader}">
        <Setter Property="FocusVisualStyle" Value="{DynamicResource {x:Static grid:GridResources.FocusVisualKey}}" />
        <Setter Property="Background" Value="{DynamicResource {x:Static grid:GridResources.HeaderBackgroundKey}}" />
        <Setter Property="Foreground" Value="{DynamicResource {x:Static grid:GridResources.HeaderForegroundKey}}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type primitives:GridColumnHeader}">
                    <Grid>
                        <Border
                            x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{DynamicResource {x:Static grid:GridResources.HeaderBorderKey}}"
                            BorderThickness="0,0,1,1">
                            <Grid Margin="8,0,6,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <ContentPresenter
                                    x:Name="HeaderContent"
                                    Grid.Column="0"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="{Binding Column.HorizontalContentAlignment, RelativeSource={RelativeSource TemplatedParent}, FallbackValue=Left}"
                                    Content="{Binding Column.Header, RelativeSource={RelativeSource TemplatedParent}}" />

                                <ToggleButton
                                    x:Name="PART_FilterButton"
                                    Grid.Column="1"
                                    Width="20"
                                    Height="20"
                                    Margin="4,0,0,0"
                                    Focusable="False"
                                    Foreground="{DynamicResource {x:Static grid:GridResources.MutedTextKey}}"
                                    ToolTip="{x:Static localization:GridStrings.FilterRowHint}"
                                    Visibility="Collapsed">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border Background="Transparent" CornerRadius="3">
                                                <Path
                                                    Data="M 1 2 L 9 2 L 6.5 5.5 L 6.5 9 L 4.5 8 L 4.5 5.5 Z"
                                                    Fill="{TemplateBinding Foreground}"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource {x:Static grid:GridResources.AccentKey}}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                </ToggleButton>

                                <Grid Grid.Column="2" Width="12" Margin="2,0,0,0" VerticalAlignment="Center">
                                    <Path
                                        x:Name="SortUp"
                                        Data="M 0 4 L 4 0 L 8 4 Z"
                                        Fill="{DynamicResource {x:Static grid:GridResources.AccentKey}}"
                                        Visibility="Collapsed" />
                                    <Path
                                        x:Name="SortDown"
                                        Data="M 0 0 L 4 4 L 8 0 Z"
                                        Fill="{DynamicResource {x:Static grid:GridResources.AccentKey}}"
                                        Visibility="Collapsed" />
                                </Grid>
                            </Grid>
                        </Border>

                        <Thumb
                            x:Name="PART_ResizeThumb"
                            Width="6"
                            HorizontalAlignment="Right"
                            Cursor="SizeWE"
                            Template="{StaticResource HeaderResizeThumbTemplate}" />

                        <Border
                            x:Name="FrozenEdge"
                            Width="2"
                            HorizontalAlignment="Right"
                            Margin="0,0,6,0"
                            Background="{DynamicResource {x:Static grid:GridResources.AccentKey}}"
                            Visibility="Collapsed" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="SortDirection" Value="Ascending">
                            <Setter TargetName="SortUp" Property="Visibility" Value="Visible" />
                            <Setter TargetName="HeaderContent" Property="TextBlock.Foreground" Value="{DynamicResource {x:Static grid:GridResources.AccentTextKey}}" />
                        </Trigger>
                        <Trigger Property="SortDirection" Value="Descending">
                            <Setter TargetName="SortDown" Property="Visibility" Value="Visible" />
                            <Setter TargetName="HeaderContent" Property="TextBlock.Foreground" Value="{DynamicResource {x:Static grid:GridResources.AccentTextKey}}" />
                        </Trigger>
                        <Trigger Property="IsFrozen" Value="True">
                            <Setter TargetName="FrozenEdge" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="ShowFilterButton" Value="True">
                            <Setter TargetName="PART_FilterButton" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsFilterApplied" Value="True">
                            <Setter TargetName="PART_FilterButton" Property="Foreground" Value="{DynamicResource {x:Static grid:GridResources.AccentKey}}" />
                        </Trigger>
                        <Trigger Property="IsDropTarget" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource {x:Static grid:GridResources.SelectionBackgroundKey}}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource {x:Static grid:GridResources.HoverBackgroundKey}}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource {x:Static grid:GridResources.SelectionBackgroundKey}}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ PropertyGrid ============ -->
    <Style TargetType="{x:Type propertyGrid:PropertyGrid}">
        <Setter Property="Background" Value="{DynamicResource {x:Static grid:GridResources.SurfaceBackgroundKey}}" />
        <Setter Property="BorderBrush" Value="{DynamicResource {x:Static grid:GridResources.HeaderBorderKey}}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="8" />
        <Setter Property="Foreground" Value="{DynamicResource {x:Static grid:GridResources.TextBrushKey}}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type propertyGrid:PropertyGrid}">
                    <Border
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        Padding="{TemplateBinding Padding}"
                        SnapsToDevicePixels="True">
                        <DockPanel>
                            <TextBox
                                x:Name="PART_SearchBox"
                                DockPanel.Dock="Top"
                                Margin="0,0,0,8"
                                VerticalContentAlignment="Center"
                                Tag="{x:Static localization:GridStrings.PropertyGridSearchHint}" />
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel x:Name="PART_ItemsHost" />
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="ShowSearchBox" Value="False">
                            <Setter TargetName="PART_SearchBox" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type propertyGridPrimitives:PropertyItemEditor}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type propertyGridPrimitives:PropertyItemEditor}">
                    <ContentPresenter />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ NumericUpDown ============ -->
    <Style TargetType="{x:Type editors:NumericUpDown}">
        <Setter Property="Foreground" Value="{DynamicResource {x:Static grid:GridResources.TextBrushKey}}" />
        <Setter Property="Background" Value="{DynamicResource {x:Static grid:GridResources.SurfaceBackgroundKey}}" />
        <Setter Property="BorderBrush" Value="{DynamicResource {x:Static grid:GridResources.HeaderBorderKey}}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type editors:NumericUpDown}">
                    <Border
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="4">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox
                                x:Name="PART_TextBox"
                                Grid.Column="0"
                                Margin="6,0,4,0"
                                VerticalContentAlignment="Center"
                                BorderThickness="0"
                                Background="Transparent"
                                TextAlignment="Right"
                                IsReadOnly="{TemplateBinding IsReadOnly}" />
                            <StackPanel Grid.Column="1" Margin="0,2,2,2">
                                <RepeatButton x:Name="PART_UpButton" Content="▴" Width="22" Height="12" Focusable="False" Padding="0">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border x:Name="Bd" Background="{DynamicResource {x:Static grid:GridResources.HoverBackgroundKey}}" CornerRadius="2,2,0,0">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource {x:Static grid:GridResources.SelectionBackgroundKey}}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                                <RepeatButton x:Name="PART_DownButton" Content="▾" Width="22" Height="12" Focusable="False" Padding="0" Margin="0,1,0,0">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border x:Name="Bd" Background="{DynamicResource {x:Static grid:GridResources.HoverBackgroundKey}}" CornerRadius="0,0,2,2">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsPressed" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource {x:Static grid:GridResources.SelectionBackgroundKey}}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </StackPanel>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ MaskedTextBox ============ -->
    <Style TargetType="{x:Type editors:AutoComplete}">
        <Setter Property="Foreground" Value="{DynamicResource {x:Static grid:GridResources.TextBrushKey}}" />
        <Setter Property="Background" Value="{DynamicResource {x:Static grid:GridResources.SurfaceBackgroundKey}}" />
        <Setter Property="BorderBrush" Value="{DynamicResource {x:Static grid:GridResources.HeaderBorderKey}}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type editors:AutoComplete}">
                    <Grid>
                        <TextBox
                            x:Name="PART_TextBox"
                            Margin="6,0,6,0"
                            VerticalContentAlignment="Center"
                            BorderThickness="0"
                            Background="Transparent"
                            Foreground="{TemplateBinding Foreground}" />
                        <Popup
                            x:Name="PART_Popup"
                            AllowsTransparency="True"
                            IsOpen="False"
                            PlacementTarget="{Binding ElementName=PART_TextBox}"
                            Placement="Bottom"
                            StaysOpen="False">
                            <Border
                                Background="{DynamicResource {x:Static grid:GridResources.SurfaceBackgroundKey}}"
                                BorderBrush="{DynamicResource {x:Static grid:GridResources.HeaderBorderKey}}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Margin="0,2,0,0"
                                MaxHeight="220"
                                MinWidth="{Binding ActualWidth, ElementName=PART_TextBox}">
                                <ListBox
                                    x:Name="PART_List"
                                    BorderThickness="0"
                                    ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
                            </Border>
                        </Popup>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type editors:MaskedTextBox}" BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="Foreground" Value="{DynamicResource {x:Static grid:GridResources.TextBrushKey}}" />
        <Setter Property="Background" Value="{DynamicResource {x:Static grid:GridResources.SurfaceBackgroundKey}}" />
        <Setter Property="BorderBrush" Value="{DynamicResource {x:Static grid:GridResources.HeaderBorderKey}}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="6,3" />
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <!-- ============ DockingManager / DockPane ============ -->
    <Style TargetType="{x:Type docking:DockingManager}">
        <Setter Property="Background" Value="{DynamicResource {x:Static grid:GridResources.SurfaceBackgroundKey}}" />
        <Setter Property="BorderBrush" Value="{DynamicResource {x:Static grid:GridResources.HeaderBorderKey}}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type docking:DockingManager}">
                    <Border
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}">
                        <Grid>
                            <!-- Layout rows/columns below; the auto-hide tab strips overlay on top. -->
                            <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition x:Name="PART_TopRow" Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition x:Name="PART_BottomRow" Height="Auto" />
                            </Grid.RowDefinitions>

                            <docking:DockZoneHost x:Name="PART_TopHost" Grid.Row="0" />

                            <GridSplitter
                                Grid.Row="1"
                                Height="4"
                                HorizontalAlignment="Stretch"
                                ResizeBehavior="PreviousAndNext"
                                ResizeDirection="Rows"
                                Visibility="{Binding HasVisiblePanes, ElementName=PART_TopHost, Converter={x:Static docking:DockingManager.BoolToVisibility}}" />

                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition x:Name="PART_LeftColumn" Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition x:Name="PART_RightColumn" Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <docking:DockZoneHost x:Name="PART_LeftHost" Grid.Column="0" />

                                <GridSplitter
                                    Grid.Column="1"
                                    Width="4"
                                    VerticalAlignment="Stretch"
                                    ResizeBehavior="PreviousAndNext"
                                    ResizeDirection="Columns"
                                    Visibility="{Binding HasVisiblePanes, ElementName=PART_LeftHost, Converter={x:Static docking:DockingManager.BoolToVisibility}}" />

                                <docking:DockZoneHost x:Name="PART_CenterHost" Grid.Column="2" />

                                <GridSplitter
                                    Grid.Column="3"
                                    Width="4"
                                    VerticalAlignment="Stretch"
                                    ResizeBehavior="PreviousAndNext"
                                    ResizeDirection="Columns"
                                    Visibility="{Binding HasVisiblePanes, ElementName=PART_RightHost, Converter={x:Static docking:DockingManager.BoolToVisibility}}" />

                                <docking:DockZoneHost x:Name="PART_RightHost" Grid.Column="4" />
                            </Grid>

                            <GridSplitter
                                Grid.Row="3"
                                Height="4"
                                HorizontalAlignment="Stretch"
                                ResizeBehavior="PreviousAndNext"
                                ResizeDirection="Rows"
                                Visibility="{Binding HasVisiblePanes, ElementName=PART_BottomHost, Converter={x:Static docking:DockingManager.BoolToVisibility}}" />

                            <docking:DockZoneHost x:Name="PART_BottomHost" Grid.Row="4" />
                            </Grid>

                            <!-- Auto-hide edge tab strips (built in code; transparent when empty). -->
                            <Grid x:Name="PART_AutoHideOverlay" />
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type docking:DockPane}">
        <Setter Property="Foreground" Value="{DynamicResource {x:Static grid:GridResources.TextBrushKey}}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type docking:DockPane}">
                    <ContentPresenter />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <!-- ============ Wizard / WizardPage ============ -->

    <Style TargetType="{x:Type wizard:WizardPage}">
        <Setter Property="Foreground" Value="{DynamicResource {x:Static grid:GridResources.TextBrushKey}}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type wizard:WizardPage}">
                    <ContentPresenter />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="{x:Type wizard:Wizard}">
        <Setter Property="Foreground" Value="{DynamicResource {x:Static grid:GridResources.TextBrushKey}}" />
        <Setter Property="Background" Value="{DynamicResource {x:Static grid:GridResources.SurfaceBackgroundKey}}" />
        <Setter Property="BorderBrush" Value="{DynamicResource {x:Static grid:GridResources.HeaderBorderKey}}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type wizard:Wizard}">
                    <Border
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="8"
                        Padding="12">
                        <DockPanel>
                            <Border
                                DockPanel.Dock="Bottom"
                                BorderBrush="{DynamicResource {x:Static grid:GridResources.HeaderBorderKey}}"
                                BorderThickness="0,1,0,0"
                                Padding="0,10,0,0"
                                Margin="0,10,0,0">
                                <StackPanel
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Right">
                                    <Button
                                        x:Name="PART_BackButton"
                                        Content="{x:Static localization:GridStrings.WizardBack}"
                                        MinWidth="88"
                                        Margin="0,0,8,0"
                                        Padding="12,6" />
                                    <Button
                                        x:Name="PART_NextButton"
                                        Content="{x:Static localization:GridStrings.WizardNext}"
                                        MinWidth="88"
                                        Margin="0,0,8,0"
                                        Padding="12,6" />
                                    <Button
                                        x:Name="PART_CancelButton"
                                        Content="{x:Static localization:GridStrings.WizardCancel}"
                                        MinWidth="88"
                                        Padding="12,6" />
                                </StackPanel>
                            </Border>
                            <ContentPresenter
                                Content="{Binding CurrentPage, RelativeSource={RelativeSource TemplatedParent}}" />
                        </DockPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <!-- ============ GanttView ============ -->

    <Style TargetType="{x:Type gantt:GanttView}">
        <Setter Property="Foreground" Value="{DynamicResource {x:Static grid:GridResources.TextBrushKey}}" />
        <Setter Property="Background" Value="{DynamicResource {x:Static grid:GridResources.SurfaceBackgroundKey}}" />
        <Setter Property="BorderBrush" Value="{DynamicResource {x:Static grid:GridResources.HeaderBorderKey}}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type gantt:GanttView}">
                    <Border
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <treeList:TreeListView x:Name="PART_Tree" Grid.Column="0" Width="420" MinWidth="220" />

                            <GridSplitter
                                Grid.Column="1"
                                Width="4"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Stretch"
                                ResizeBehavior="PreviousAndNext"
                                ResizeDirection="Columns" />

                            <ScrollViewer
                                x:Name="PART_TimelineScroll"
                                Grid.Column="2"
                                VerticalScrollBarVisibility="Auto"
                                HorizontalScrollBarVisibility="Auto">
                                <gantt:GanttTimelinePanel x:Name="PART_Timeline" />
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ SchedulerView ============ -->

    <Style TargetType="{x:Type scheduler:SchedulerView}">
        <Setter Property="Foreground" Value="{DynamicResource {x:Static grid:GridResources.TextBrushKey}}" />
        <Setter Property="Background" Value="{DynamicResource {x:Static grid:GridResources.SurfaceBackgroundKey}}" />
        <Setter Property="BorderBrush" Value="{DynamicResource {x:Static grid:GridResources.HeaderBorderKey}}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type scheduler:SchedulerView}">
                    <Border
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}">
                        <Grid>
                            <ScrollViewer
                                x:Name="PART_DaysScroll"
                                VerticalScrollBarVisibility="Auto"
                                HorizontalScrollBarVisibility="Auto">
                                <scheduler:SchedulerDaysPanel x:Name="PART_Days" />
                            </ScrollViewer>
                            <scheduler:SchedulerMonthPanel
                                x:Name="PART_Month"
                                Visibility="Collapsed" />
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
