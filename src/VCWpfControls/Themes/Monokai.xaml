<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:grid="clr-namespace:VCWpfControls.Grid">

    <!-- Monokai — the second chained palette (Dark.xaml merged for every template and
         implicit style, brush tokens overridden only). Classic Wimer Vermeer colors:
         #272822 surfaces, #F8F8F2 text, #49483E selection, cyan #66D9EF accent/links,
         green #A6E22E interactive chrome, orange #FD971F current cell, pink #F92672
         now-line. Muted/comment gray brightened to #A1A08D for the 4.5:1 gate. -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/VCWpfControls;component/Themes/Dark.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <SolidColorBrush x:Key="{x:Static grid:GridResources.SurfaceBackgroundKey}" Color="#FF272822" />
    <SolidColorBrush x:Key="{x:Static grid:GridResources.HeaderBackgroundKey}" Color="#FF1E1F19" />
    <SolidColorBrush x:Key="{x:Static grid:GridResources.HeaderForegroundKey}" Color="#FFF8F8F2" />
    <SolidColorBrush x:Key="{x:Static grid:GridResources.HeaderBorderKey}" Color="#FF49483E" />
    <SolidColorBrush x:Key="{x:Static grid:GridResources.SelectionBackgroundKey}" Color="#FF49483E" />
    <SolidColorBrush x:Key="{x:Static grid:GridResources.SelectionTextKey}" Color="#FFF8F8F2" />
    <SolidColorBrush x:Key="{x:Static grid:GridResources.CurrentCellBorderBrushKey}" Color="#FFFD971F" />
    <SolidColorBrush x:Key="{x:Static grid:GridResources.GridLineKey}" Color="#FF3B3A32" />
    <SolidColorBrush x:Key="{x:Static grid:GridResources.AccentKey}" Color="#FF66D9EF" />
    <SolidColorBrush x:Key="{x:Static grid:GridResources.AccentTextKey}" Color="#FF66D9EF" />
    <SolidColorBrush x:Key="{x:Static grid:GridResources.HoverBackgroundKey}" Color="#FF3E3D32" />
    <SolidColorBrush x:Key="{x:Static grid:GridResources.TextBrushKey}" Color="#FFF8F8F2" />
    <SolidColorBrush x:Key="{x:Static grid:GridResources.AlternatingRowBackgroundKey}" Color="#FF2E2F28" />
    <SolidColorBrush x:Key="{x:Static grid:GridResources.MutedTextKey}" Color="#FFA1A08D" />
    <SolidColorBrush x:Key="{x:Static grid:GridResources.BarFillKey}" Color="#FF49483E" />
    <SolidColorBrush x:Key="{x:Static grid:GridResources.SeparatorLineKey}" Color="#FF3B3A32" />
    <SolidColorBrush x:Key="{x:Static grid:GridResources.EventFillKey}" Color="#4666D9EF" />
    <SolidColorBrush x:Key="{x:Static grid:GridResources.NowLineKey}" Color="#FFF92672" />
    <SolidColorBrush x:Key="{x:Static grid:GridResources.BaselineFillKey}" Color="#6E75715E" />
    <SolidColorBrush x:Key="{x:Static grid:GridResources.ErrorTextKey}" Color="#FFFF99A4" />
    <SolidColorBrush x:Key="{x:Static grid:GridResources.MenuHoverBackgroundKey}" Color="#FF3E3D32" />
    <SolidColorBrush x:Key="{x:Static grid:GridResources.OnAccentTextKey}" Color="#FF272822" />
</ResourceDictionary>
