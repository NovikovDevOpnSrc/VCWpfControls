<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net6.0-windows;net8.0-windows</TargetFrameworks>
    <UseWPF>true</UseWPF>
    <RootNamespace>VCWpfControls</RootNamespace>
    <AssemblyName>VCWpfControls</AssemblyName>
    <!-- net6.0-windows target limits the language version; keep the library C# 10 compatible. -->
    <LangVersion>10.0</LangVersion>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <PackageId>VCWpfControls</PackageId>
    <Title>Vibe Coded WPF Controls</Title>
    <Description>Free and open-source WPF controls. Stage 1: a fast, MVVM-friendly GridControl with virtualization, sorting, filtering, grouping, editing, validation and export. Documentation in English, Russian and Chinese.</Description>
    <PackageTags>wpf;controls;grid;datagrid;gridcontrol;mvvm;virtualization</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="All" />
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="VCWpfControls.Core.Tests" />
    <InternalsVisibleTo Include="VCWpfControls.Control.Tests" />
    <InternalsVisibleTo Include="VCWpfControls.UiTests" />
    <InternalsVisibleTo Include="VCWpfControls.Benchmarks" />
  </ItemGroup>

</Project>
