<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- LiveCharts2 transitive SkiaSharp/OpenTK assets fall back to net-framework (NU1701). -->
    <NoWarn>$(NoWarn);NU1701</NoWarn>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>VCWpfControls.Demo</RootNamespace>
    <AssemblyName>VCWpfControls.Demo</AssemblyName>
    <AssemblyTitle>Vibe Coded WPF Controls Demo</AssemblyTitle>
    <!-- The demo window must stay open long enough for UI tests to attach. -->
    <ApplicationManifest></ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="MahApps.Metro.IconPacks.Material" />
    <PackageReference Include="LiveChartsCore.SkiaSharpView.WPF" />
    <PackageReference Include="Fluent.Ribbon" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\VCWpfControls\VCWpfControls.csproj" />
  </ItemGroup>

</Project>
