<Window x:Class="VCWpfControls.Demo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:VCWpfControls.Demo.Views"
        xmlns:vm="clr-namespace:VCWpfControls.Demo.ViewModels"
        xmlns:grid="clr-namespace:VCWpfControls.Grid;assembly=VCWpfControls"
        Title="Vibe Coded WPF Controls — Demo"
        Width="1180" Height="720"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:BasicSampleViewModel}">
            <views:BasicSampleView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ColumnTypesSampleViewModel}">
            <views:ColumnTypesSampleView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SortingSampleViewModel}">
            <views:SortingSampleView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SelectionSampleViewModel}">
            <views:SelectionSampleView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:EditingSampleViewModel}">
            <views:EditingSampleView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AnalyticsSampleViewModel}">
            <views:AnalyticsSampleView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:DockingSampleViewModel}">
            <views:DockingSampleView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:EditorsSampleViewModel}">
            <views:EditorsSampleView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:IntegrationSampleViewModel}">
            <views:IntegrationSampleView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ConditionSampleViewModel}">
            <views:ConditionSampleView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PivotSampleViewModel}">
            <views:PivotSampleView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:GanttSampleViewModel}">
            <views:GanttSampleView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SchedulerSampleViewModel}">
            <views:SchedulerSampleView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:WizardSampleViewModel}">
            <views:WizardSampleView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:TreeListSampleViewModel}">
            <views:TreeListSampleView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PropertyGridSampleViewModel}">
            <views:PropertyGridSampleView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:VirtualizationSampleViewModel}">
            <views:VirtualizationSampleView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsSampleViewModel}">
            <views:SettingsSampleView />
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- The shell follows the library palette so the global Light/Dark theme
             repaints the navigation sidebar as well (DynamicResource). -->
        <Border Grid.Column="0"
                Background="{DynamicResource {x:Static grid:GridResources.HeaderBackgroundKey}}"
                BorderBrush="{DynamicResource {x:Static grid:GridResources.HeaderBorderKey}}"
                BorderThickness="0,0,1,0">
            <ListBox x:Name="NavList"
                     Margin="8"
                     SelectedIndex="0"
                     ItemsSource="{Binding Samples}"
                     SelectedItem="{Binding SelectedSample, Mode=TwoWay}"
                     DisplayMemberPath="Title" />
        </Border>

        <Grid Grid.Column="1" Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       FontSize="22" FontWeight="SemiBold"
                       Text="{Binding SelectedSample.Title}" />
            <TextBlock Grid.Row="1"
                       Margin="0,4,0,12" Opacity="0.7"
                       Text="{Binding SelectedSample.Description}" />

            <ContentControl Grid.Row="2"
                            Content="{Binding SelectedSample}" />
        </Grid>
    </Grid>
</Window>
