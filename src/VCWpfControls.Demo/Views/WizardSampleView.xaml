<UserControl x:Class="VCWpfControls.Demo.Views.WizardSampleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wizard="clr-namespace:VCWpfControls.Wizard;assembly=VCWpfControls">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock
            x:Name="Status"
            Margin="0,0,0,10"
            Opacity="0.75"
            Text="Page 1 of 3 — check the box below to allow leaving this page." />

        <wizard:Wizard x:Name="TheWizard" Grid.Row="1">
            <wizard:WizardPage Header="Welcome">
                <StackPanel>
                    <TextBlock Text="Welcome to the wizard demo." TextWrapping="Wrap" />
                    <CheckBox
                        x:Name="AllowLeave"
                        Margin="0,12,0,0"
                        Content="I have read the introduction (allows Next)"
                        IsChecked="False" />
                </StackPanel>
            </wizard:WizardPage>
            <wizard:WizardPage Header="Details">
                <StackPanel>
                    <TextBlock Text="Enter anything — the second page never blocks." TextWrapping="Wrap" />
                    <TextBox Margin="0,12,0,0" Padding="6" Text="some details" />
                </StackPanel>
            </wizard:WizardPage>
            <wizard:WizardPage Header="Finish">
                <TextBlock Text="Last page: the Next button becomes Finish." TextWrapping="Wrap" />
            </wizard:WizardPage>
        </wizard:Wizard>
    </Grid>
</UserControl>
