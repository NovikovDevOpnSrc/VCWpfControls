<UserControl x:Class="VCWpfControls.Demo.Views.ChromeSampleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:grid="clr-namespace:VCWpfControls.Grid;assembly=VCWpfControls">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="560" HorizontalAlignment="Left">

            <TextBlock FontSize="16" FontWeight="SemiBold" Text="Tabs" />
            <TabControl Margin="0,4,0,16">
                <TabItem Header="First">
                    <TextBlock Text="First page content." />
                </TabItem>
                <TabItem Header="Second">
                    <TextBlock Text="Second page content." />
                </TabItem>
            </TabControl>

            <TextBlock FontSize="16" FontWeight="SemiBold" Text="Expander &amp; GroupBox" />
            <StackPanel Margin="0,4,0,16">
                <Expander Header="Details" IsExpanded="True">
                    <TextBlock Text="Expanded content lives here." />
                </Expander>
                <GroupBox Header="Group" Margin="0,8,0,0">
                    <TextBlock Text="Grouped content." />
                </GroupBox>
            </StackPanel>

            <TextBlock FontSize="16" FontWeight="SemiBold" Text="Slider &amp; progress" />
            <StackPanel Margin="0,4,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Slider x:Name="Value" Minimum="0" Maximum="100" Value="40" />
                    <TextBlock Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center"
                               FontSize="12" Foreground="{DynamicResource {x:Static grid:GridResources.MutedTextKey}}"
                               Text="{Binding ElementName=Value, Path=Value, StringFormat={}{0:0}}" />
                </Grid>
                <ProgressBar Margin="0,12,0,0" Minimum="0" Maximum="100" Value="40" Height="12" />
            </StackPanel>

            <TextBlock FontSize="16" FontWeight="SemiBold" Text="Lists &amp; trees" />
            <Grid Margin="0,4,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ListBox x:Name="List" MinHeight="120" />
                <TreeView Grid.Column="2" MinHeight="120">
                    <TreeViewItem Header="Root" IsExpanded="True">
                        <TreeViewItem Header="Child one" />
                        <TreeViewItem Header="Child two" />
                    </TreeViewItem>
                </TreeView>
            </Grid>

            <TextBlock FontSize="16" FontWeight="SemiBold" Text="ToolTip" />
            <TextBlock
                Margin="0,4,0,0"
                FontSize="12"
                Foreground="{DynamicResource {x:Static grid:GridResources.MutedTextKey}}"
                Text="Hover the button — the tooltip follows the theme."
                ToolTipService.Placement="Bottom" />
            <Button Content="Hover me" Margin="0,8,0,0" Padding="12,4" HorizontalAlignment="Left"
                    ToolTip="A themed tooltip" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
