<UserControl x:Class="VCWpfControls.Demo.Views.SelectionSampleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:grid="clr-namespace:VCWpfControls.Grid;assembly=VCWpfControls">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
            <CheckBox x:Name="CellUnitToggle" VerticalAlignment="Center"
                      Checked="OnCellUnitToggled" Unchecked="OnCellUnitToggled"
                      Content="Cell selection (click, Shift/Ctrl rectangles, Shift+arrows, copy)" />
            <TextBlock x:Name="CellCount" Margin="16,0,0,0" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource {x:Static grid:GridResources.MutedTextKey}}"
                       Text="0 cells selected" />
        </StackPanel>
        <grid:GridControl x:Name="Grid"
                      ItemsSource="{Binding Employees}"
                      SelectionMode="Extended"
                      RowHeight="28"
                      RowDetailsVisibilityMode="VisibleWhenSelected"
                      AlternatingRowBackground="{DynamicResource {x:Static grid:GridResources.AlternatingRowBackgroundKey}}">
        <grid:GridControl.RowDetailsTemplate>
            <DataTemplate>
                <Border Margin="12,4,12,8" Padding="12" Background="{DynamicResource {x:Static grid:GridResources.SelectionBackgroundKey}}" CornerRadius="8">
                    <StackPanel>
                        <TextBlock FontSize="14" FontWeight="SemiBold" Text="{Binding Name}" />
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <TextBlock Opacity="0.6" Text="{Binding Email}" />
                            <TextBlock Margin="12,0,0,0" Opacity="0.6" Text="{Binding Department}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </DataTemplate>
        </grid:GridControl.RowDetailsTemplate>
    </grid:GridControl>
    </DockPanel>
</UserControl>
