<UserControl x:Class="VCWpfControls.Demo.Views.SelectionSampleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:grid="clr-namespace:VCWpfControls.Grid;assembly=VCWpfControls">
    <grid:GridControl x:Name="Grid"
                      ItemsSource="{Binding Employees}"
                      SelectionMode="Extended"
                      RowHeight="28"
                      RowDetailsVisibilityMode="VisibleWhenSelected"
                      AlternatingRowBackground="#FFFAFBFC">
        <grid:GridControl.RowDetailsTemplate>
            <DataTemplate>
                <Border Margin="12,4,12,8" Padding="10" Background="#FFEFF6FF" CornerRadius="6">
                    <StackPanel>
                        <TextBlock FontSize="14" FontWeight="SemiBold" Text="{Binding Name}" />
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <TextBlock Opacity="0.6" Text="{Binding Email}" />
                            <TextBlock Margin="12,0,0,0" Opacity="0.6" Text="{Binding Department}" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </DataTemplate>
        </grid:GridControl.RowDetailsTemplate>
    </grid:GridControl>
</UserControl>
