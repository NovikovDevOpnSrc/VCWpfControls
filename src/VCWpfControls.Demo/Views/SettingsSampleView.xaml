<UserControl x:Class="VCWpfControls.Demo.Views.SettingsSampleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:VCWpfControls.Demo.Converters">
    <UserControl.Resources>
        <converters:EqualsConverter x:Key="EqualsConverter" />
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,8,0,0" MaxWidth="560" HorizontalAlignment="Left">
            <TextBlock Text="Theme" FontWeight="SemiBold" Margin="0,0,0,6" />
            <StackPanel Orientation="Horizontal">
                <RadioButton Content="Light"
                             IsChecked="{Binding Theme, Converter={StaticResource EqualsConverter}, ConverterParameter=Light}"
                             Margin="0,0,16,0"
                             AutomationProperties.AutomationId="SettingsThemeLightRadio" />
                <RadioButton Content="Dark"
                             IsChecked="{Binding Theme, Converter={StaticResource EqualsConverter}, ConverterParameter=Dark}"
                             AutomationProperties.AutomationId="SettingsThemeDarkRadio" />
            </StackPanel>

            <TextBlock Text="Accent" FontWeight="SemiBold" Margin="0,18,0,6" />
            <ComboBox ItemsSource="{Binding AccentOptions}"
                      SelectedItem="{Binding Accent}"
                      Width="180" HorizontalAlignment="Left"
                      AutomationProperties.AutomationId="SettingsAccentCombo" />

            <TextBlock Text="Language (library strings)" FontWeight="SemiBold" Margin="0,18,0,6" />
            <ComboBox ItemsSource="{Binding LanguageOptions}"
                      SelectedItem="{Binding Language}"
                      Width="240" HorizontalAlignment="Left"
                      AutomationProperties.AutomationId="SettingsLanguageCombo" />
            <TextBlock Text="Switches the localized library strings (grid menus, hints, wizard buttons, empty states). Demo page texts stay English; already rendered strings refresh on the next interaction."
                       Opacity="0.7" TextWrapping="Wrap" Margin="0,6,0,0" />

            <Button Content="Reset to defaults"
                    Click="OnReset"
                    Margin="0,24,0,0" Padding="12,6" HorizontalAlignment="Left"
                    AutomationProperties.AutomationId="SettingsResetButton" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
