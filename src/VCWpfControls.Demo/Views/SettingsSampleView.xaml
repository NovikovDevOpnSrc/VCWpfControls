<UserControl x:Class="VCWpfControls.Demo.Views.SettingsSampleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:VCWpfControls.Demo.Converters"
             xmlns:grid="clr-namespace:VCWpfControls.Grid;assembly=VCWpfControls">
    <UserControl.Resources>
        <converters:EqualsConverter x:Key="EqualsConverter" />
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,8,0,0" MaxWidth="560" HorizontalAlignment="Left">
            <TextBlock Text="Theme" FontWeight="SemiBold" Foreground="{DynamicResource {x:Static grid:GridResources.TextBrushKey}}" Margin="0,0,0,6" />
            <StackPanel Orientation="Horizontal">
                <RadioButton Content="Light" Foreground="{DynamicResource {x:Static grid:GridResources.TextBrushKey}}"
                             IsChecked="{Binding Theme, Converter={StaticResource EqualsConverter}, ConverterParameter=Light}"
                             Margin="0,0,16,0"
                             AutomationProperties.AutomationId="SettingsThemeLightRadio" />
                <RadioButton Content="Dark" Foreground="{DynamicResource {x:Static grid:GridResources.TextBrushKey}}"
                             IsChecked="{Binding Theme, Converter={StaticResource EqualsConverter}, ConverterParameter=Dark}"
                             Margin="0,0,16,0"
                             AutomationProperties.AutomationId="SettingsThemeDarkRadio" />
                <RadioButton Content="High contrast (follow Windows)"
                             IsChecked="{Binding Theme, Converter={StaticResource EqualsConverter}, ConverterParameter=HighContrast}"
                             Foreground="{DynamicResource {x:Static grid:GridResources.TextBrushKey}}"
                             Margin="0,0,16,0"
                             AutomationProperties.AutomationId="SettingsThemeHighContrastRadio" />
                <RadioButton Content="System (follow Windows)"
                             IsChecked="{Binding Theme, Converter={StaticResource EqualsConverter}, ConverterParameter=System}"
                             Foreground="{DynamicResource {x:Static grid:GridResources.TextBrushKey}}"
                             AutomationProperties.AutomationId="SettingsThemeSystemRadio" />
            </StackPanel>

            <TextBlock Text="Accent" FontWeight="SemiBold" Foreground="{DynamicResource {x:Static grid:GridResources.TextBrushKey}}" Margin="0,16,0,6" />
            <ComboBox ItemsSource="{Binding AccentOptions}"
                      SelectedItem="{Binding Accent}"
                      Width="180" HorizontalAlignment="Left"
                      AutomationProperties.AutomationId="SettingsAccentCombo" />

            <TextBlock Text="Language (library strings)" FontWeight="SemiBold" Foreground="{DynamicResource {x:Static grid:GridResources.TextBrushKey}}" Margin="0,16,0,6" />
            <ComboBox ItemsSource="{Binding LanguageOptions}"
                      SelectedItem="{Binding Language}"
                      Width="240" HorizontalAlignment="Left"
                      AutomationProperties.AutomationId="SettingsLanguageCombo" />
            <TextBlock Text="Switches the localized library strings (grid menus, hints, wizard buttons, empty states). Demo page texts stay English; already rendered strings refresh on the next interaction."
                       TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource {x:Static grid:GridResources.MutedTextKey}}" Margin="0,6,0,0" />

            <Button Content="Reset to defaults"
                    Click="OnReset"
                    Margin="0,24,0,0" Padding="12,8" HorizontalAlignment="Left"
                    AutomationProperties.AutomationId="SettingsResetButton" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
