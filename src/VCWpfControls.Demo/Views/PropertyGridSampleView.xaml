<UserControl x:Class="VCWpfControls.Demo.Views.PropertyGridSampleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:grid="clr-namespace:VCWpfControls.Grid;assembly=VCWpfControls"
             xmlns:propertyGrid="clr-namespace:VCWpfControls.PropertyGrid;assembly=VCWpfControls">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="380" />
        </Grid.ColumnDefinitions>

        <grid:GridControl x:Name="Grid"
                          Grid.Column="0"
                          ItemsSource="{Binding Employees}"
                          SelectionMode="SingleRow"
                          AutoGenerateColumns="True"
                          RowHeight="28" />

        <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Stretch" Background="{DynamicResource {x:Static grid:GridResources.HeaderBorderKey}}" />

        <propertyGrid:PropertyGrid Grid.Column="2"
                                   SelectedObject="{Binding SelectedItem, ElementName=Grid}"
                                   LabelWidth="110" />
    </Grid>
</UserControl>
