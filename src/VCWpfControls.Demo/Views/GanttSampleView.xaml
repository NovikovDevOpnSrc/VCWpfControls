<UserControl x:Class="VCWpfControls.Demo.Views.GanttSampleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:grid="clr-namespace:VCWpfControls.Grid;assembly=VCWpfControls"
             xmlns:gantt="clr-namespace:VCWpfControls.Gantt;assembly=VCWpfControls">
    <DockPanel>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
            <CheckBox Content="Auto-schedule"
                      IsChecked="{Binding AutoSchedule}"
                      Margin="0,0,12,0" VerticalAlignment="Center" />
            <CheckBox Content="Critical path"
                      IsChecked="{Binding ShowCriticalPath}"
                      Margin="0,0,12,0" VerticalAlignment="Center" />
            <CheckBox Content="Skip weekends"
                      IsChecked="{Binding SkipWeekends}"
                      Margin="0,0,12,0" VerticalAlignment="Center" />
            <CheckBox Content="Baseline"
                      IsChecked="{Binding ShowBaseline}"
                      Margin="0,0,12,0" VerticalAlignment="Center" />
            <CheckBox Content="Legend"
                      IsChecked="{Binding ShowLegend}"
                      Margin="0,0,12,0" VerticalAlignment="Center" />
            <CheckBox Content="Bar labels"
                      IsChecked="{Binding ShowBarLabels}"
                      Margin="0,0,12,0" VerticalAlignment="Center" />
            <ComboBox ItemsSource="{Binding Units}"
                      SelectedItem="{Binding TimescaleUnit}"
                      Width="90" VerticalAlignment="Center" />
            <Button Content="Reset"
                    Click="OnReset"
                    Margin="12,0,0,0" Padding="12,4" VerticalAlignment="Center" />
            <TextBlock Text="{Binding LastAction}"
                       VerticalAlignment="Center" Margin="16,0,0,0"
                       FontSize="12" Foreground="{DynamicResource {x:Static grid:GridResources.MutedTextKey}}" TextTrimming="CharacterEllipsis" />
        </StackPanel>
        <gantt:GanttView Tasks="{Binding Tasks}"
                         Dependencies="{Binding Dependencies}"
                         AutoSchedule="{Binding AutoSchedule}"
                         ShowCriticalPath="{Binding ShowCriticalPath}"
                         Calendar="{Binding Calendar}"
                         ShowBaseline="{Binding ShowBaseline}"
                         ShowLegend="{Binding ShowLegend}"
                         ShowBarLabels="{Binding ShowBarLabels}"
                         TimescaleUnit="{Binding TimescaleUnit}"
                         TaskEdited="OnTaskEdited"
                         LinkCreated="OnLinkCreated" />
    </DockPanel>
</UserControl>
