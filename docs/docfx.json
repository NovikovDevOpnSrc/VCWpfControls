{
  // Build the site with:  docfx docs/docfx.json --serve
  // The API reference is generated from the RELEASE build of the library; build it first:
  //   dotnet build src/VCWpfControls -c Release
  "build": {
    "content": [
      {
        "files": [
          "index.md",
          "ux-checklist.md",
          "toc.yml",
          "en/**/*.md",
          "en/toc.yml",
          "ru/**/*.md",
          "ru/toc.yml",
          "zh/**/*.md",
          "zh/toc.yml",
          "api/**/*.yml",
          "api/toc.yml"
        ]
      }
    ],
    "resource": [
      {
        "files": [
          "images/**"
        ]
      }
    ],
    "output": "_site",
    "globalMetadata": {
      "_appTitle": "Vibe Coded WPF Controls",
      "_appFooter": "Vibe Coded WPF Controls — <a href=\"https://github.com/NovikovDevOpnSrc/VCWpfControls\">GitHub</a> · MIT License",
      "_enableSearch": true
    },
    "template": [
      "default"
    ],
    "markdownEngineName": "markdig"
  }
}
