{
  // Static-content configuration (DocFX v2).
  // Build the site with:  docfx docs/docfx.json --serve
  //
  // API reference generation is intentionally disabled at this stage.
  // To enable it later, build the library first (dotnet build src/VCWpfControls),
  // then uncomment the "metadata" section below and reference the generated
  // api/**/*.md files from a toc.yml:
  //
  // "metadata": [
  //   {
  //     "src": [
  //       {
  //         "files": [ "../src/VCWpfControls/bin/Debug/net8.0-windows/VCWpfControls.dll" ],
  //         "cwd": "."
  //       }
  //     ],
  //     "dest": "api",
  //     "memberLayout": "samePage"
  //   }
  // ],
  "build": {
    "content": [
      {
        "files": [
          "index.md",
          "toc.yml",
          "en/**/*.md",
          "en/toc.yml",
          "ru/**/*.md",
          "ru/toc.yml",
          "zh/**/*.md",
          "zh/toc.yml"
        ]
      }
    ],
    "resource": [
      {
        "files": [
          "images/**"
        ]
      }
    ],
    "output": "_site",
    "globalMetadata": {
      "_appTitle": "Vibe Coded WPF Controls",
      "_appFooter": "Vibe Coded WPF Controls — <a href=\"https://github.com/vibe-coded/VCWpfControls\">GitHub</a> · MIT License",
      "_enableSearch": true
    },
    "template": [
      "default"
    ],
    "markdownEngineName": "markdig"
  }
}
